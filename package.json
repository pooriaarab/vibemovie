{
  "name": "vibemovie",
  "version": "0.2.5",
  "description": "Coding-session recap generator with offline Hyperframes HTML, optional WaveSpeed AI video, ElevenLabs narration, FFmpeg assembly, and MCP.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "bin": {
    "vibemovie": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/mcp.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@pooriaarab/vibe-core": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.0"
  },
  "homepage": "https://github.com/pooriaarab/vibemovie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/vibemovie.git"
  },
  "bugs": {
    "url": "https://github.com/pooriaarab/vibemovie/issues"
  },
  "keywords": [
    "vibemovie",
    "coding-recap",
    "hyperframes",
    "wavespeed",
    "elevenlabs",
    "ffmpeg",
    "kling",
    "seedream",
    "claude-code",
    "codex",
    "gemini-cli",
    "mcp",
    "video-generation",
    "local-first"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.pooriaarab/vibemovie"
}
