{
  "name": "vibemovie",
  "version": "0.2.4",
  "description": "Your agent coding session as a short recap video — Hyperframes (HTML/CSS/JS) with zero gen-video keys, or your own video model. For Claude Code, Codex, Gemini, and other agentic CLIs. Local-first.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "bin": {
    "vibemovie": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/mcp.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@pooriaarab/vibe-core": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "homepage": "https://github.com/pooriaarab/vibemovie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/vibemovie.git"
  },
  "bugs": {
    "url": "https://github.com/pooriaarab/vibemovie/issues"
  },
  "keywords": [
    "vibe-suite",
    "vibemovie",
    "claude-code",
    "codex",
    "agentic",
    "cli",
    "mcp",
    "video",
    "hyperframes",
    "local-first"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.pooriaarab/vibemovie"
}
